# Porta local do servidor
PORT=3000

# --- IA que atua como Mestre de Jogo ---
# Prefixo RPG_AI_ (em vez de ANTHROPIC_*) de propósito: o Claude Code (CLI) também
# usa variáveis ANTHROPIC_API_KEY/ANTHROPIC_MODEL/ANTHROPIC_BASE_URL no ambiente do
# sistema (ex: ao trocar de modelo com /model), e elas vazam para processos filhos,
# sobrescrevendo silenciosamente o que está aqui. Nomes próprios evitam a colisão.

# Chave de API (Anthropic oficial ou um proxy compatível com a Messages API)
RPG_AI_API_KEY=coloque_sua_chave_aqui

# Endereço base da API. Padrão = API oficial da Anthropic.
# Se for usar um proxy/gateway próprio, troque aqui (ex: https://meuproxy.exemplo.com).
RPG_AI_BASE_URL=https://api.anthropic.com

# Caminho do endpoint de mensagens, caso seu proxy use um caminho diferente do padrão.
RPG_AI_API_PATH=/v1/messages

# Versão da API exigida pelo cabeçalho anthropic-version
RPG_AI_API_VERSION=2023-06-01

# Modelo usado pelo Mestre de Jogo
# Para o proxy sixtysix.online, use um dos IDs liberados pela sua chave
# (confira em GET {RPG_AI_BASE_URL}/models): claude-fable-5.2, claude-opus.5.5, etc.
RPG_AI_MODEL=claude-fable-5.2
# Modelo reserva (última tentativa quando o principal responde 503). Vazio = repete o principal.
RPG_AI_MODEL_RESERVA=
# Proxy SOCKS5 opcional para a chamada da IA (ex.: socks5h://127.0.0.1:1080). Vazio = direto.
RPG_AI_PROXY=
# Tempo máximo (ms) esperando a IA antes de mostrar erro ao jogador. Padrão: 60000.
RPG_AI_TIMEOUT_MS=60000

# --- Narração por voz (ElevenLabs TTS, opcional) ---
# Sem chave, o jogo usa a voz do navegador (Web Speech API).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=jLIW7D3ar1H9coBmNcVS
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Contas / magic link (cadastro por email) ---
# Endereço público usado nos links enviados por email.
PUBLIC_URL=https://4ever.janeri.com.br
# SMTP local sem autenticação (ex.: Postfix escutando no loopback).
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
MAIL_FROM=noreply@janeri.com.br
MAIL_FROM_NAME="4Ever RPG"
# Tempo de cada vez (ms). Quem não age nesse prazo é pulado; 3 pulos = Afastado.
RPG_TEMPO_TURNO_MS=60000
# Tempo para rolar um teste de dado (ms); o relógio da vez fica pausado. Sem rolar = falha automática.
RPG_TEMPO_DADO_MS=60000

# --- Ilustrações de cena (API compatível com OpenAI /v1/images/generations) ---
# Sem chave, o jogo funciona normalmente, só sem imagens.
# Vazios = usa o mesmo gateway/chave/proxy do Mestre (RPG_AI_*).
RPG_IMG_BASE_URL=https://www.sixtysix.online/v1
RPG_IMG_API_KEY=
RPG_IMG_MODEL=gemini-3-pro-image
RPG_IMG_SIZE=1536x1024
# Limites de custo: máximo de imagens por mesa e intervalo mínimo entre elas (ms).
RPG_IMG_MAX_POR_SALA=12
RPG_IMG_INTERVALO_MS=180000

# Monitor do gateway: recebe um email quando modelos/rotas da IA mudam (cron de hora em hora).
MONITOR_EMAIL=
