# Porta local do servidor
PORT=3000

# --- IA que atua como Mestre de Jogo ---
# Prefixo RPG_AI_ (em vez de ANTHROPIC_*) de propósito: o Claude Code (CLI) também
# usa variáveis ANTHROPIC_API_KEY/ANTHROPIC_MODEL/ANTHROPIC_BASE_URL no ambiente do
# sistema (ex: ao trocar de modelo com /model), e elas vazam para processos filhos,
# sobrescrevendo silenciosamente o que está aqui. Nomes próprios evitam a colisão.

# Chave de API (Anthropic oficial ou um proxy compatível com a Messages API)
RPG_AI_API_KEY=coloque_sua_chave_aqui

# Endereço base da API. Padrão = API oficial da Anthropic.
# Se for usar um proxy/gateway próprio, troque aqui (ex: https://meuproxy.exemplo.com).
RPG_AI_BASE_URL=https://api.anthropic.com

# Caminho do endpoint de mensagens, caso seu proxy use um caminho diferente do padrão.
RPG_AI_API_PATH=/v1/messages

# Versão da API exigida pelo cabeçalho anthropic-version
RPG_AI_API_VERSION=2023-06-01

# Modelo usado pelo Mestre de Jogo
# Para o proxy sixtysix.online, use um dos IDs liberados pela sua chave
# (confira em GET {RPG_AI_BASE_URL}/models): claude-fable-5.2, claude-opus.5.5, etc.
RPG_AI_MODEL=claude-fable-5.2
